{
  "name": "leaks-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Music/leak management desktop application",
  "main": "out/main/main.js",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "pnpm --filter ./svelte dev",
    "build": "pnpm --filter ./svelte build",
    "check": "pnpm --filter ./svelte check",
    "test": "pnpm rebuild better-sqlite3 && pnpm --filter ./svelte test:run && vitest run",
    "test:frontend": "pnpm --filter ./svelte test:run",
    "test:main": "pnpm rebuild better-sqlite3 && vitest run",
    "preelectron:dev": "electron-rebuild -f --build-from-source -w better-sqlite3",
    "electron:dev": "electron-vite dev",
    "dev:app": "trap 'kill 0' EXIT; pnpm dev & pnpm electron:dev",
    "electron:build": "electron-vite build",
    "electron:rebuild": "electron-rebuild -f --force-abi 146 -w better-sqlite3",
    "electron:prebuild": "pnpm electron:build && pnpm --filter ./svelte build && pnpm electron:rebuild",
    "prepackage": "pnpm electron:prebuild",
    "package": "electron-forge package",
    "premake": "pnpm electron:prebuild",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7",
    "@electron-forge/maker-dmg": "^7",
    "@electron-forge/maker-zip": "^7",
    "@electron-forge/plugin-auto-unpack-natives": "^7",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "electron": "^42.11.16",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "mediabunny": "^1.46.0"
  }
}
